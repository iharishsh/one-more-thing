// One More Thing — agreements, prices, payments are app-owned.
// AI suggestions are stored on ChangeRequest; published Proposal.termsJson is immutable.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  DRAFT
  PUBLISHED
  ACCEPTED
  SUPERSEDED
  REVOKED
  DECLINED
  CHANGES_REQUESTED
}

enum PaymentStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  REFUNDED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum OptionKind {
  SWAP
  DELAY
  EXTRA_PRICE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/** Whether the project has a usable agreement baseline. */
enum AgreementStatus {
  /** Intake only — no baseline yet. */
  UNCONFIRMED
  /** Freelancer recorded what was already agreed outside the app. */
  FREELANCER_RECORDED
  /** Client accepted a proposal that established or updated the agreement. */
  CLIENT_ACCEPTED
}

enum ClientResponseAction {
  DECLINE
  REQUEST_CHANGES
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  WAITING_CLIENT
  DRAFT_READY
  NEEDS_REVIEW
  FAILED
  CANCELLED
}

enum AgentJobStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
}

enum ThreadMessageKind {
  SYSTEM
  CLIENT_REQUEST
  CLARIFICATION_DRAFT
  CLARIFICATION_QUESTION
  CLIENT_ANSWER
  /** Freelancer-attributed call/WhatsApp notes — not client acceptance. */
  FREELANCER_NOTE
  ACTIVITY
  DRAFT_SUMMARY
}

enum ThreadMessageVisibility {
  SHARED
  PRIVATE
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  /** Supabase auth.users id when AUTH_MODE=supabase */
  authSubject String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id                  String          @id @default(cuid())
  ownerId             String
  title               String
  status              ProjectStatus   @default(ACTIVE)
  agreementStatus     AgreementStatus @default(FREELANCER_RECORDED)
  /** How/when the freelancer recorded an existing agreement (not client acceptance). */
  agreementSource     String?
  agreementRecordedAt DateTime?
  /** Client's opening ask when the project started without a confirmed agreement. */
  openingRequest      String?
  originalScope       String
  currentScope        String
  currentScopeVersion Int             @default(1)
  /** Parsed or set revision allowance; null = unknown from agreement text */
  revisionRoundsTotal Int?
  revisionRoundsUsed  Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  owner               User            @relation(fields: [ownerId], references: [id])
  changeRequests      ChangeRequest[]
  deliverables        Deliverable[]
  activityEvents      ActivityEvent[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, agreementStatus])
}

model ChangeRequest {
  id                    String        @id @default(cuid())
  projectId             String
  clientMessage         String
  /** Freelancer-reported call/email context — not recorded client acceptance. */
  discussionNotes       String?
  discussedPriceCents   Int?
  discussedDeliveryNote String?
  scopeVersionAnalyzed  Int
  analysisJson          Json?
  /** Bumped on human analysis edits; agent runs bind to this revision. */
  analysisRevision      Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  project               Project       @relation(fields: [projectId], references: [id])
  proposals             Proposal[]
  changeThread          ChangeThread?
  agentRuns             AgentRun[]

  @@index([projectId])
}

/** Shared clarification thread — invite is independent of proposal tokens. */
model ChangeThread {
  id              String                @id @default(cuid())
  changeRequestId String                @unique
  inviteToken     String                @unique
  revokedAt       DateTime?
  /** If true, further outbound clarifications skip freelancer approval. */
  autoClarify     Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  changeRequest   ChangeRequest         @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  messages        ChangeThreadMessage[]
  agentRuns       AgentRun[]
}

model ChangeThreadMessage {
  id              String                   @id @default(cuid())
  threadId        String
  kind            ThreadMessageKind
  visibility      ThreadMessageVisibility  @default(SHARED)
  body            String
  metadataJson    Json?
  /** Dedupes client answers / retries for the same pending clarification. */
  idempotencyKey  String?
  createdAt       DateTime                 @default(now())
  thread          ChangeThread             @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, idempotencyKey])
  @@index([threadId, createdAt])
}

model AgentRun {
  id                       String         @id @default(cuid())
  changeRequestId          String
  threadId                 String
  status                   AgentRunStatus @default(QUEUED)
  stepCount                Int            @default(0)
  maxSteps                 Int            @default(12)
  agreementVersionAtStart  Int
  agreementVersionChecked  Int?
  /** analysisRevision on ChangeRequest when this run's analysis input was captured. */
  inputRevision            Int            @default(0)
  analysisSnapshotJson     Json?
  pendingClarificationJson Json?
  draftStale               Boolean        @default(false)
  needsReviewReason        String?
  lastError                String?
  claimedAt                DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  changeRequest            ChangeRequest  @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  thread                   ChangeThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  jobs                     AgentJob[]

  @@index([changeRequestId, status])
  @@index([status, updatedAt])
}

/** Durable work units — processed by the in-process agent worker. */
model AgentJob {
  id          String         @id @default(cuid())
  runId       String
  type        String
  status      AgentJobStatus @default(PENDING)
  payloadJson Json?
  availableAt DateTime       @default(now())
  claimedAt   DateTime?
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now())
  run         AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([runId, status])
}

model Proposal {
  id              String           @id @default(cuid())
  changeRequestId String
  version         Int
  status          ProposalStatus   @default(DRAFT)
  summary         String
  /** Immutable after publish — never store client responses here */
  termsJson       Json
  priceCents      Int
  currency        String           @default("USD")
  clientToken     String           @unique
  tokenExpiresAt  DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  changeRequest   ChangeRequest    @relation(fields: [changeRequestId], references: [id])
  acceptance      Acceptance?
  clientResponses ClientResponse[]
  payments        Payment[]
  deliverables    Deliverable[]

  @@unique([changeRequestId, version])
  @@index([status])
}

model Acceptance {
  id              String   @id @default(cuid())
  proposalId      String   @unique
  proposalVersion Int
  clientName      String?
  acknowledgment  String
  acceptedAt      DateTime @default(now())
  proposal        Proposal @relation(fields: [proposalId], references: [id])
}

/** Separate from termsJson so published proposal terms stay immutable */
model ClientResponse {
  id              String               @id @default(cuid())
  proposalId      String
  proposalVersion Int
  action          ClientResponseAction
  message         String?
  clientName      String?
  createdAt       DateTime             @default(now())
  proposal        Proposal             @relation(fields: [proposalId], references: [id])

  @@index([proposalId, createdAt])
}

model Payment {
  id                  String        @id @default(cuid())
  proposalId          String
  /** Snapshot at order create — capture must match this version/amount */
  proposalVersion     Int
  paypalOrderId       String?       @unique
  paypalCaptureId     String?       @unique
  expectedAmountCents Int
  currency            String        @default("USD")
  status              PaymentStatus @default(CREATED)
  captureRequestId    String?       @unique
  rawCaptureJson      Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  proposal            Proposal      @relation(fields: [proposalId], references: [id])

  @@index([proposalId, status])
}

model Deliverable {
  id          String    @id @default(cuid())
  projectId   String
  proposalId  String?
  title       String
  description String?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id])
  proposal    Proposal? @relation(fields: [proposalId], references: [id])

  @@index([projectId])
  @@index([proposalId])
}

model WebhookEvent {
  id          String                  @id @default(cuid())
  eventId     String                  @unique
  eventType   String
  status      WebhookProcessingStatus @default(RECEIVED)
  payloadJson Json
  attemptCount Int                    @default(0)
  lastError   String?
  /** Set while a worker owns processing — prevents concurrent double-apply */
  claimedAt   DateTime?
  processedAt DateTime?
  createdAt   DateTime                @default(now())
}

model ActivityEvent {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
}
